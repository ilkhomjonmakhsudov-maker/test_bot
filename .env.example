# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here

# polling (local dev) | webhook (production)
BOT_MODE=polling

# Required only for webhook mode — must be a public HTTPS URL
WEBHOOK_URL=https://your-domain.onrender.com

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Telegram Mini App (veb panel) ────────────────────────────────────────────
# Public HTTPS origin of THIS server, no trailing slash.
# The 🌐 Veb panel button in /panel only appears when this resolves to an
# https:// address — Telegram rejects web_app buttons that are not HTTPS.
# Leave it empty and the inline /panel still works; only the web button hides.
#
# Resolution order: PUBLIC_URL → RENDER_EXTERNAL_URL (set by Render) → WEBHOOK_URL
# So in webhook mode, or on Render, you usually do not need to set this at all.
PUBLIC_URL=https://your-domain.onrender.com

# ─── Super Admin ──────────────────────────────────────────────────────────────
# Comma-separated Telegram IDs of super admins (can add/remove teachers)
# Super admins also have all teacher capabilities
SUPER_ADMIN_IDS=123456789

# ─── Teachers ─────────────────────────────────────────────────────────────────
# Path to the JSON file listing all teachers (admins)
# Super admins can add teachers via /addteacher — no file edit needed
ADMINS_FILE_PATH=./admins.json

# ─── Session settings ─────────────────────────────────────────────────────────
# Auto-expire test sessions after N minutes (0 = never)
SESSION_TTL_MINUTES=0

# Directory where active session snapshots (JSON) are stored while test is running
# Files are deleted automatically after /yakunla command
SESSION_DATA_PATH=./data/sessions

# ─── Statistics ───────────────────────────────────────────────────────────────
# Completed-test counters for the super admin panel. Sessions are deleted once
# results are sent, so this file is the only lasting record of totals.
STATS_FILE_PATH=./data/stats.json
